{
  "manifest_version": 3,
  "name": "Navra Capture",
  "description": "کپچر اطلاعات خودروی مورد نظر و ارسال به ناوراکار",
  "version": "1.3.2",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.dubizzle.com/*",
    "*://*.dubicars.com/*",
    "*://*.yallamotor.com/*",
    "https://navracar.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dubizzle.com/*",
        "*://*.dubicars.com/*",
        "*://*.yallamotor.com/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Navra Capture"
  },
  "commands": {
    "capture-current-listing": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "ارسال خودروی کنونی به ناوراکار"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}