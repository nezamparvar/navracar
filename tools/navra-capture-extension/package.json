{
  "name": "navra-capture-extension",
  "version": "1.3.1",
  "description": "Navra Capture Browser Extension for NavraCar",
  "scripts": {
    "build": "npm run bundle && npm run archive:staging && npm run archive:production && npm run checksum",
    "archive:staging": "node scripts/archive.js staging",
    "archive:production": "node scripts/archive.js production",
    "checksum": "node scripts/checksum.js",
    "bundle": "node scripts/bundle.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js src/**/*.ts",
    "dev": "npm run bundle && echo 'Extension bundled. Load from dist/staging'"
  },
  "keywords": [
    "chrome",
    "extension",
    "vehicle",
    "navracar"
  ],
  "author": "Navra",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@types/chrome": "^0.0.252",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "archiver": "7.0.1",
    "eslint": "8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.2.2"
  }
}
